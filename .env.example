# Copy these into `.dev.vars` (local) or `npx wrangler pages secret put <NAME>` (production).
# Every value here is optional — the site works without any of them.

# --- Instant notifications when a visitor sends a message or a review ---

# Telegram (recommended): create a bot with @BotFather, then:
#   TELEGRAM_BOT_TOKEN=123456:ABC...
#   TELEGRAM_CHAT_ID=123456789
#   TELEGRAM_WEBHOOK_SECRET=some-long-random-string
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ntfy.sh push notifications (free, no account):
NTFY_TOPIC=

# --- Email replies to visitors ---

# Option A — Resend (needs a verified domain):
#   RESEND_API_KEY=re_...
#   RESEND_FROM="Portfolio <hello@your-domain.com>"
RESEND_API_KEY=
RESEND_FROM=

# Option B — a Google Apps Script webhook (works without your own domain):
GMAIL_WEBHOOK_URL=
GMAIL_WEBHOOK_SECRET=
